# Rust
/target
/src-tauri/target
/src-tauri/gen

# Frontend
/node_modules
/dist
*.tsbuildinfo

# NVIDIA's CUDA runtime, copied in by src-tauri/build.rs so the installer can
# carry it. Their files, not ours, and regenerated on every build.
/src-tauri/cuda-runtime

# Whisper models — downloaded at runtime into the app data dir, and a copy here
# during development. Hundreds of megabytes; never committed.
/models

# Editors and OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Local overrides
.env
.env.local

# Release artefacts. The manifest is generated from a build, not written by
# hand, and it names a signature — nothing here belongs in git.
/dist-release
