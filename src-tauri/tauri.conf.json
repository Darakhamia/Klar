{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klar",
  "version": "0.3.2",
  "identifier": "app.klar.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klar",
        "width": 900,
        "height": 620,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "onboarding",
        "url": "onboarding.html",
        "title": "Welcome to Klar",
        "width": 680,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Klar overlay",
        "width": 380,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://getklar.net/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNjg3MTIwMjg0M0MzMkIKUldRcncwTW9JSEZvUHg1L3Z0R1AwN3BoRGJ5aTV2Y2FkNzNES202dE5jR0RWZmh6V0VwbENIdDEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Messy speech in, finished text out.",
    "longDescription": "Hold a hotkey anywhere, speak, release. Klar transcribes locally, cleans the text up, and types it at your cursor.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerIcon": "installer/installer.ico",
        "uninstallerIcon": "installer/uninstaller.ico"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
