{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klar",
  "version": "0.1.0",
  "identifier": "app.klar.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klar",
        "width": 900,
        "height": 620,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Klar overlay",
        "width": 380,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Messy speech in, finished text out.",
    "longDescription": "Hold a hotkey anywhere, speak, release. Klar transcribes locally, cleans the text up, and types it at your cursor.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
